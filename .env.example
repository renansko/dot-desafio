# Exporte estas variáveis no shell: Django não carrega .env automaticamente.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Classificação antes da geração: chave presente seleciona Jev; vazia usa o provedor do chat.
# Pergunta e histórico também serão enviados à TypeSafe quando habilitada.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# JSONL local das decisões; rotaciona em 5 MB e mantém três arquivos anteriores.
CHAT_DECISION_LOG_PATH=var/log/chat-decisions.log

# Para Anthropic, selecione CHAT_PROVIDER=anthropic e um CHAT_MODEL disponível na sua conta.
ANTHROPIC_API_KEY=
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_QUESTION_CHARS=4000
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_TOTAL_CHARS=16000

# Opcional. true requer LANGSMITH_API_KEY; pode enviar conteúdo das conversas ao LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dot-desafio


# Embeddings (Busca Semântica)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Opcional: revisão fixa do modelo Hugging Face; reconstruir ao trocar.
EMBEDDING_REVISION=

# OpenAI alternativo: EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
SEARCH_INDEX_PATH=var/search/index.zip
SEARCH_CHUNK_SIZE=400
SEARCH_CHUNK_OVERLAP=60
